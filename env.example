# ============================================
# REQUIRED PARAMETERS
# ============================================

# Slack Webhook URL (required)
# Get it at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============================================
# PARSER SELECTION
# ============================================

# Enable/disable specific parsers (true/false)
ENABLE_OLX=true

# ⚠️  IMPORTANT: Otodom doesn't support all filters!
# Otodom will show ALL listings matching: district, rooms, price, area
# But CANNOT filter by: furniture, pets, listing type (private/business)
# This means you'll get MORE results from Otodom than from OLX
ENABLE_OTODOM=false

# ============================================
# APARTMENT SEARCH PARAMETERS
# ============================================

# District name in Warsaw (lowercase, no spaces)
# Common districts: srodmiescie, wola, mokotow, praga-polnoc, praga-poludnie, zoliborz, ursynow
# Multiple districts: wola,ursynow,kabaty,natolin,imielin,stoklosy
# To find your district, search on OLX with filters and check the URL: /warszawa/q-DISTRICT_NAME/
DISTRICT_NAME=wola

# ⚠️  FLOORS filter is NOT supported by OLX API (breaks URL and returns random results)
# Keeping for documentation only - not used in actual filtering
# FLOORS=1,2,3,4,5,6,7,8,9

# Furnished apartments
# yes = furnished, no = unfurnished
FURNITURE=yes

# Pets allowed
# Tak = yes, Nie = no
PETS=Tak

# Number of rooms
# one = 1, two = 2, three = 3, four = 4
ROOMS=three

# Price from (PLN)
PRICE_FROM=4000

# Price to (PLN)
PRICE_TO=6000

# Listing type
# private = private listings, business = from agencies
LISTING_TYPE=private

# ============================================
# APARTMENT SEARCH PARAMETERS (OTODOM)
# ============================================

# District name for Otodom (lowercase, no spaces)
# Examples: wola, mokotow, praga-polnoc, srodmiescie
# Multiple districts: wola,ursynow,kabaty,natolin,imielin,stoklosy
# Leave empty to search all Warsaw districts
OTODOM_DISTRICT=wola

# Area parameters (same for both OLX and Otodom)
# For houses only AREA_FROM is used, rooms are not filtered
AREA_FROM=60
AREA_TO=90

# Property types for Otodom: mieszkanie (flats), dom (houses), comma-separated
OTODOM_PROPERTY_TYPES=mieszkanie

# Semi-detached houses (bliźniak) in ALL Warsaw districts, bus distance shown but not filtered
OTODOM_WARSAW_SEMI_DETACHED=false

# Suburb towns as Otodom location paths, searched with a radius around each
# Districts filter applies only to Warsaw listings; suburbs pass by location
# OTODOM_SUBURBS=piaseczynski/piaseczno/piaseczno
OTODOM_SUBURB_RADIUS_KM=10

# Result pages per search (36 listings each, newest first)
OTODOM_MAX_PAGES=2

# Max straight-line distance to the nearest school bus stop (see bus_stops.py)
# Listings further away are skipped. 0 = don't filter, only show the distance
BUS_MAX_DISTANCE_M=1500
SUBURB_BUS_MAX_DISTANCE_M=5000

# ============================================
# OPERATION SETTINGS
# ============================================

# Operation mode
# once = single run
# loop = continuous monitoring
RUN_MODE=once

# Check interval in seconds (only for loop mode)
# Recommended at least 180 seconds (3 minutes)
CHECK_INTERVAL=300

# ============================================
# PROXY SETTINGS (Optional)
# ============================================

# Proxy server for bypassing geo-blocking
# Useful when running from servers outside Poland
# Format: http://host:port or http://user:pass@host:port
# Leave empty or comment out if not needed
# PROXY_URL=http://your-proxy-server:port

